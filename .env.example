# MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=project
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_password

# Flask
SECRET_KEY=replace_with_a_random_secret
FLASK_DEBUG=0

# Packet capture and flow extraction
CAPTURE_INTERFACE=WLAN
CAPTURE_DIRECTORY=C:\path\to\Machine_Learning_IDS\DATA
TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe
CICFLOWMETER_COMMAND=C:\path\to\CICFlowMeter-4.0\bin\cfm.bat
